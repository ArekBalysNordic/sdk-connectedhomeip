# The purpose of this file is to define new default values of settings used when building Matter samples.
# This file only changes defaults and thus all symbols here must be promptless
# and safeguarded so that they only are applied when building Matter.

config MATTER_STACK_NRF_DEFAULT_CONFIGURATION
    bool "Use Matter nRF Connect SDK default configuration"
    depends on CHIP
    default y
    help
      Use Matter nRF Connect SDK default configuration dedicated for nRF Connect SoCs.

if MATTER_STACK_NRF_DEFAULT_CONFIGURATION

# ==============================================================================
# System configuration
# ==============================================================================

choice LIBC_IMPLEMENTATION
    default PICOLIBC
endchoice

choice POSIX_SYSCONF_IMPL_CHOICE
    default POSIX_SYSCONF_IMPL_MACRO if PICOLIBC

endchoice

configdefault ASSERT
    default y

configdefault ASSERT_NO_COND_INFO
    default y

configdefault ASSERT_NO_MSG_INFO
    default y

configdefault HW_STACK_PROTECTION
    default y

configdefault ZVFS_OPEN_MAX
    default 30

configdefault MAIN_STACK_SIZE
    default 6144

configdefault INIT_STACKS
    default y

configdefault SYSTEM_WORKQUEUE_STACK_SIZE
    default 2560 if CHIP_WIFI
    default 2048 if CHIP_ICD_LIT_SUPPORT

if CHIP_WIFI

configdefault HEAP_MEM_POOL_SIZE
    default 48336 if BUILD_WITH_TFM
    default 43008 if CHIP_WIFI
    default 40144

configdefault NRF_WIFI_DATA_HEAP_SIZE
    default 42384 if BUILD_WITH_TFM
    default 50576

endif # CHIP_WIFI

configdefault HEAP_MEM_POOL_IGNORE_MIN
    default y if CHIP_WIFI

configdefault CHIP_MALLOC_SYS_HEAP_SIZE
    default 14336 if CHIP_WIFI
    default 10240

configdefault MPSL_WORK_STACK_SIZE
    default 2048 if SOC_SERIES_NRF54L # nRF54L requires more memory due to crypto backend

# We use sys_heap based allocators, so make sure we don't reserve unused libc heap anyway
configdefault COMMON_LIBC_MALLOC_ARENA_SIZE
    default -1

configdefault NVS_LOOKUP_CACHE_SIZE
    default 512 if NVS

configdefault ZMS_LOOKUP_CACHE_SIZE
    default 512 if ZMS

# Enable Dynamic interrupts to have a possibility to reconfigure it for devices that use MPSL
# on the application core and needs synchronization between MPSL and FLASH driver.
if MPSL

configdefault DYNAMIC_INTERRUPTS
    default y

configdefault DYNAMIC_DIRECT_INTERRUPTS
    default y

configdefault MPSL_DYNAMIC_INTERRUPTS
    default y

endif # MPSL

if NORDIC_QSPI_NOR

configdefault NORDIC_QSPI_NOR_STACK_WRITE_BUFFER_SIZE
	default 16

endif # NORDIC_QSPI_NOR

if SPI_NOR

configdefault SPI_NOR_FLASH_LAYOUT_PAGE_SIZE
	default 4096

configdefault PM_OVERRIDE_EXTERNAL_DRIVER_CHECK
	default y

endif # SPI_NOR

# ==============================================================================
# Zephyr networking configuration
# ==============================================================================

if NETWORKING

configdefault NET_IPV6_MLD
    default y

configdefault NET_IPV6_NBR_CACHE
    default y if CHIP_WIFI
    default n if NET_L2_OPENTHREAD

configdefault NET_IF_UNICAST_IPV6_ADDR_COUNT
    default 6

configdefault NET_IF_MCAST_IPV6_ADDR_COUNT
    default 14

configdefault NET_IF_IPV6_PREFIX_COUNT
    default NET_IF_UNICAST_IPV6_ADDR_COUNT if CHIP_WIFI

configdefault NET_PKT_RX_COUNT
    default 8

configdefault NET_PKT_TX_COUNT
    default 8

configdefault NET_BUF_RX_COUNT
    default 16

configdefault NET_BUF_TX_COUNT
    default 16

configdefault NET_SOCKETS_POLL_MAX
    default 6 if CHIP_WIFI

endif # NETWORKING

# ==============================================================================
# Bluetooth Low Energy configuration
# ==============================================================================

configdefault BT
    default y

configdefault BT_PERIPHERAL
    default y

configdefault BT_PERIPHERAL_PREF_MIN_INT
    default 36

configdefault BT_PERIPHERAL_PREF_MAX_INT
    default 36

# Increase BT timeout to 5 s to improve connection reliability and avoid fast drop outs.
configdefault BT_PERIPHERAL_PREF_TIMEOUT
    default 500

configdefault BT_GAP_AUTO_UPDATE_CONN_PARAMS
    default y

# Decrease connection parameters update time, as some Matter controllers request
# enabling IP networking faster than BT connection parameters are updated, what may result
# in commissioning instabilities.
configdefault BT_CONN_PARAM_UPDATE_TIMEOUT
    default 1000

configdefault BT_GATT_DYNAMIC_DB
    default y

configdefault BT_DEVICE_NAME_DYNAMIC
    default y

configdefault BT_DEVICE_NAME_MAX
    default 15

configdefault BT_MAX_CONN
    default 1

configdefault BT_L2CAP_TX_MTU
    default 247

configdefault BT_BUF_ACL_RX_SIZE
    default 251

configdefault BT_BUF_ACL_TX_SIZE
    default 251

# It is set based on BT_BUF_ACL_RX_COUNT_EXTRA = 6 - (BT_MAX_CONN + 1)
configdefault BT_BUF_ACL_RX_COUNT_EXTRA
    default 4

configdefault BT_RX_STACK_SIZE
    default 1200

# Increase maximum data length of PDU supported in the Controller
configdefault BT_CTLR_DATA_LENGTH_MAX
    default 251 if SOC_SERIES_NRF52

configdefault BT_CTLR_ECDH
    default n

configdefault BT_CTLR_LE_ENC
    default n

configdefault BT_DEVICE_NAME_GATT_WRITABLE
    default n

configdefault BT_GATT_CACHING
    default n

# Disable 2M PHY due to interoperability issues.
configdefault BT_CTLR_PHY_2M
    default n

configdefault MPSL_FEM_NRF21540_RUNTIME_PA_GAIN_CONTROL
    default y if MPSL_FEM

# ==============================================================================
# NFC Onboarding Payload configuration
# ==============================================================================

configdefault CHIP_NFC_ONBOARDING_PAYLOAD
    default y

# Disable not needed NFC callback to save flash
configdefault NFC_THREAD_CALLBACK
    default n

# ==============================================================================
# DFU configuration
# ==============================================================================

configdefault CHIP_OTA_REQUESTOR
    default y

configdefault BOOT_IMAGE_ACCESS_HOOKS
    default y if SOC_SERIES_NRF53

configdefault UPDATEABLE_IMAGE_NUMBER
    default 3 if NRF_WIFI_PATCHES_EXT_FLASH_STORE
    default 2 if SOC_SERIES_NRF53

configdefault DFU_MULTI_IMAGE_MAX_IMAGE_COUNT
    default 3 if NRF_WIFI_PATCHES_EXT_FLASH_STORE

configdefault NRF_WIFI_FW_PATCH_DFU
    default y if NRF_WIFI_PATCHES_EXT_FLASH_STORE

# ==============================================================================
# OpenThread L2 configuration
# ==============================================================================

configdefault NET_L2_OPENTHREAD
    default y if !CHIP_WIFI && NETWORKING

if NET_L2_OPENTHREAD

# Increase the default RX stack size
configdefault IEEE802154_NRF5_RX_STACK_SIZE
    default 1024

endif # NET_L2_OPENTHREAD

# ==============================================================================
# OpenThread configuration
# ==============================================================================

configdefault OPENTHREAD
    default y if !CHIP_WIFI

if OPENTHREAD

configdefault OPENTHREAD_THREAD_STACK_SIZE
    default 6144 if (PSA_CRYPTO_DRIVER_CC3XX && PSA_CRYPTO_DRIVER_OBERON) || PSA_CRYPTO_DRIVER_CRACEN
    default 4096

configdefault OPENTHREAD_DEFAULT_TX_POWER
    default 20 if MPSL_FEM
    default 3 if SOC_SERIES_NRF53
    default 8 if SOC_SERIES_NRF52 || SOC_SERIES_NRF54L

endif # OPENTHREAD

configdefault CHIP_USE_ZEPHYR_NETWORKING
    default n

# ==============================================================================
# ICD configuration
# ==============================================================================

if CHIP_ENABLE_ICD_SUPPORT

configdefault CHIP_ICD_SLOW_POLL_INTERVAL
    default 300000 if CHIP_ICD_LIT_SUPPORT # Use the same value as CONFIG_CHIP_ICD_IDLE_MODE_DURATION
    default 2500

configdefault CHIP_ICD_SIT_SLOW_POLL_LIMIT
 	default 15000

configdefault CHIP_ICD_FAST_POLLING_INTERVAL
 	default 500

configdefault CHIP_ICD_IDLE_MODE_DURATION
 	default 300 if CHIP_ICD_LIT_SUPPORT
 	default 120

configdefault CHIP_ICD_ACTIVE_MODE_THRESHOLD
 	default 5000 if CHIP_ICD_LIT_SUPPORT
 	default 0

endif # CHIP_ENABLE_ICD_SUPPORT

# ==============================================================================
# Wi-Fi configuration
# ==============================================================================

if CHIP_WIFI

choice WIFI_NM_WPA_SUPPLICANT_LOG_LEVEL_CHOICE
    default WIFI_NM_WPA_SUPPLICANT_LOG_LEVEL_ERR
endchoice

# it saves us 20kB of FLASH
configdefault WIFI_NM_WPA_SUPPLICANT_NO_DEBUG
    default y

configdefault NRF70_LOG_VERBOSE
    default n

choice WIFI_NRF70_LOG_LEVEL_CHOICE
    default WIFI_NRF70_LOG_LEVEL_OFF
endchoice

configdefault NRF_WIFI_LOW_POWER
    default n

configdefault NRF70_RX_NUM_BUFS
    default 16

configdefault NRF70_MAX_TX_TOKENS
    default 10

configdefault NRF70_MAX_TX_AGGREGATION
    default 1

# it saves 25kB of FLASH
configdefault WIFI_NM_WPA_SUPPLICANT_ADVANCED_FEATURES
    default n

endif # CHIP_WIFI

# ==============================================================================
# Crypto configuration
# ==============================================================================

choice OPENTHREAD_SECURITY_CONFIG
    default OPENTHREAD_NRF_SECURITY_PSA_CHOICE if CHIP_CRYPTO_PSA
endchoice

choice RNG_GENERATOR_CHOICE
    default XOSHIRO_RANDOM_GENERATOR if SOC_SERIES_NRF53
endchoice

configdefault MBEDTLS_ENABLE_HEAP
    default y if !BUILD_WITH_TFM
    default n

configdefault MBEDTLS_HEAP_SIZE
    default 8192

# Enable PSA Crypto dependencies for Matter

configdefault CHIP_CRYPTO_PSA
    default y

if CHIP_CRYPTO_PSA

configdefault PSA_WANT_ALG_SPAKE2P_MATTER
    default y

configdefault PSA_WANT_KEY_TYPE_SPAKE2P_KEY_PAIR_IMPORT
    default y if PSA_CRYPTO_DRIVER_OBERON

configdefault CHIP_CRYPTO_PSA_AEAD_SINGLE_PART
    default y if SOC_SERIES_NRF54L

configdefault PSA_CRYPTO_DRIVER_OBERON
    default y if (SOC_SERIES_NRF52 || SOC_SERIES_NRF53)

configdefault PSA_CRYPTO_DRIVER_CC3XX
    default n

configdefault PSA_CRYPTO_DRIVER_CRACEN
    default y if SOC_SERIES_NRF54L

configdefault PSA_WANT_ALG_SHA_224
    default n

# Extend the maximum number of PSA key slots to fit Matter requirements
configdefault MBEDTLS_PSA_KEY_SLOT_COUNT
    default 64

if PSA_CRYPTO_DRIVER_CC3XX && PSA_CRYPTO_DRIVER_OBERON

# Do not use CC3XX hash driver when both Oberon and CC3xx are enabled.
configdefault PSA_USE_CC3XX_HASH_DRIVER
    default n

endif # PSA_CRYPTO_DRIVER_CC3XX && PSA_CRYPTO_DRIVER_OBERON

endif # CHIP_CRYPTO_PSA

if !CHIP_CRYPTO_PSA

configdefault MBEDTLS_AES_C
    default y

configdefault MBEDTLS_CTR_DRBG_C
    default y

configdefault MBEDTLS_CIPHER_MODE_CTR
    default y

configdefault MBEDTLS_MD_C
    default y

configdefault MBEDTLS_SHA256_C
    default y

configdefault MBEDTLS_PK_C
    default y

configdefault MBEDTLS_PKCS5_C
    default y

configdefault MBEDTLS_PK_WRITE_C
    default y

configdefault MBEDTLS_X509_CREATE_C
    default y

configdefault MBEDTLS_X509_CSR_WRITE_C
    default y

configdefault MBEDTLS_ECP_C
    default y

endif # !CHIP_CRYPTO_PSA

configdefault MBEDTLS_ASN1_WRITE_C
    default y

configdefault MBEDTLS_SSL_OUT_CONTENT_LEN
    default 900 if CHIP_WIFI

# Disable unneeded crypto operations

configdefault MBEDTLS_SSL_SRV_C
    default n

configdefault MBEDTLS_SSL_COOKIE_C
    default n

# ==============================================================================
# Logging configuration
# ==============================================================================

configdefault LOG
    default y

if LOG

choice LOG_MODE
    default LOG_MODE_MINIMAL
endchoice

choice MATTER_LOG_LEVEL_CHOICE
    default MATTER_LOG_LEVEL_DBG
endchoice

configdefault CHIP_APP_LOG_LEVEL
    default 4 # debug

configdefault LOG_DEFAULT_LEVEL
    default 1 # error

configdefault CHIP_LOG_SIZE_OPTIMIZATION
    default y

# disable synchronous printk to avoid blocking IRQs which
# may affect time sensitive components
configdefault PRINTK_SYNC
    default n

endif # LOG

# ==============================================================================
# Shell configuration
# ==============================================================================

configdefault SHELL
    default y if CHIP_LIB_SHELL

if CHIP_LIB_SHELL

# Currently the CHIPArgParser uses the standard getopt() API. Building with Zephyr's
# shim getopt (which uses Zephyr's sys_getopt) does not work for this. So let's disable
# it, and use directly the C library standard getopt.
choice POSIX_AEP_CHOICE
	default POSIX_AEP_CHOICE_NONE

endchoice

endif # CHIP_LIB_SHELL

if SHELL

configdefault SHELL_STACK_SIZE
    default 2616 if CHIP_WIFI

configdefault SHELL_MINIMAL
    default y if !CHIP_MEMORY_PROFILING

configdefault KERNEL_SHELL
    default n if !CHIP_MEMORY_PROFILING

configdefault SHELL_WILDCARD
	default n

configdefault SENSOR_SHELL
    default n

configdefault DEVICE_SHELL
    default n

configdefault DATE_SHELL
    default n

configdefault DEVMEM_SHELL
    default n

configdefault MCUBOOT_SHELL
    default n

configdefault CLOCK_CONTROL_NRF_SHELL
    default n

configdefault FLASH_SHELL
    default n

configdefault HWINFO_SHELL
    default n

configdefault OPENTHREAD_SHELL
    default n if !CHIP_MEMORY_PROFILING

configdefault SHELL_CMD_BUFF_SIZE
    default 512 if CHIP_MEMORY_PROFILING

endif # SHELL

# ==============================================================================
# Features configuration
# ==============================================================================

if CHIP_DFU_OVER_BT_SMP

# MCU Manager and SMP configuration
choice MCUMGR_TRANSPORT_BT_PERM
	default MCUMGR_TRANSPORT_BT_PERM_RW
endchoice

config MCUMGR_TRANSPORT_NETBUF_COUNT
	default 6

config MCUMGR_MGMT_NOTIFICATION_HOOKS
	bool
	default y

config MCUMGR_GRP_IMG_UPLOAD_CHECK_HOOK
	bool
	default y

config MCUMGR_SMP_COMMAND_STATUS_HOOKS
	bool
	default y

# Increase BT MTU and RX buffer sizes to improve DFU throughput on non-RAM-constrained devices
config BT_L2CAP_TX_MTU
	default 498 if !SOC_NRF54L10

config BT_BUF_ACL_RX_SIZE
	default 502 if !SOC_NRF54L10

# Increase MCUMGR_TRANSPORT_NETBUF_SIZE, as it must be big enough to fit MAX MTU + overhead and for single-image DFU default is 384 B
config MCUMGR_TRANSPORT_NETBUF_SIZE
	default 1024

# Increase system workqueue size, as SMP is processed within it
config SYSTEM_WORKQUEUE_STACK_SIZE
	default 2800

if SOC_SERIES_NRF53

# Enable custom SMP request to erase settings partition.
config MCUMGR_GRP_ZBASIC
	default y

config MCUMGR_GRP_ZBASIC_STORAGE_ERASE
	default y

endif # SOC_SERIES_NRF53

endif # CHIP_DFU_OVER_BT_SMP

endif # MATTER_STACK_NRF_DEFAULT_CONFIGURATION
